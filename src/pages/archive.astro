---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import SiteShell from '../components/SiteShell.astro';
import { SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.filter((entry) => !entry.data.draft && entry.data.kind === 'article')
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const groupedPosts = posts.reduce<Record<string, typeof posts>>((groups, post) => {
	const year = String(post.data.pubDate.getFullYear());
	groups[year] ??= [];
	groups[year].push(post);
	return groups;
}, {});
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`Archive | ${SITE_TITLE}`} description="按年份整理的文章归档。" />
	</head>
	<body>
		<SiteShell>
			<p class="eyebrow">ARCHIVE</p>
			{
				Object.entries(groupedPosts)
					.sort(([a], [b]) => Number(b) - Number(a))
					.map(([year, yearPosts]) => (
						<section>
							<div class="section-heading">
								<h2>{year}</h2>
								<span class="writing-meta">{yearPosts.length} 篇</span>
							</div>
							<ul class="writing-list">
								{yearPosts.map((post) => (
									<li class="writing-item">
										<FormattedDate date={post.data.pubDate} />
										<div>
											<h3 class="writing-title">
												<a href={`/blog/${post.id}/`}>{post.data.title}</a>
											</h3>
										</div>
									</li>
								))}
							</ul>
						</section>
					))
			}
		</SiteShell>
	</body>
</html>
