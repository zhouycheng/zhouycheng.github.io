---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import SiteShell from '../components/SiteShell.astro';
import { SITE_TITLE } from '../consts';

const entries = (await getCollection('blog'))
	.filter((entry) => !entry.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const logs = entries.filter((entry) => entry.data.kind === 'log');
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`日志 | ${SITE_TITLE}`} description="每天或隔几天写下来的感悟和记录。" />
	</head>
	<body>
		<SiteShell>
			<p class="eyebrow">LOGS</p>
			{
				logs.length > 0 ? (
					<ul class="writing-list note-list">
						{logs.map((log) => (
							<li class="writing-item">
								<FormattedDate date={log.data.pubDate} />
								<div>
									<h3 class="writing-title">
										<a href={`/blog/${log.id}/`}>{log.data.title}</a>
									</h3>
								</div>
							</li>
						))}
					</ul>
				) : (
					<p class="muted">还没有日志。</p>
				)
			}
		</SiteShell>
	</body>
</html>
