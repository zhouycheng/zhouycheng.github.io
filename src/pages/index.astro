---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import SiteShell from '../components/SiteShell.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const entries = (await getCollection('blog'))
	.filter((entry) => !entry.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const articles = entries.filter((entry) => entry.data.kind === 'article');
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="home-page">
		<SiteShell class="home-shell">
			<section class="home-feed" aria-labelledby="home-feed-title">
				<p class="eyebrow" id="home-feed-title">ARTICLES</p>
				<ul class="home-writing-list">
					{
						articles.map((post) => (
							<li class="home-writing-item">
								<h2 class="home-post-title writing-title">
									<a href={`/blog/${post.id}/`}>{post.data.title}</a>
									{post.data.description && (
										<span class="description-popover">{post.data.description}</span>
									)}
								</h2>
								<p class="home-post-date">Date · <FormattedDate date={post.data.pubDate} /></p>
							</li>
						))
					}
				</ul>
			</section>
		</SiteShell>
	</body>
</html>
