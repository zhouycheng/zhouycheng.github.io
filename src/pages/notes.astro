---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const notes = (await getCollection('blog'))
	.filter((entry) => !entry.data.draft && entry.data.kind === 'note')
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`短记 | ${SITE_TITLE}`} description="一些还没有长成完整文章的短想法。" />
	</head>
	<body>
		<Header />
		<main>
			<section class="page-intro">
				<p class="eyebrow">Notes</p>
				<h1>短记</h1>
				<p class="muted">暂时还不需要写成长文的观察、摘录、判断和片段。</p>
			</section>

			<ul class="writing-list note-list">
				{
					notes.map((note) => (
						<li class="writing-item">
							<FormattedDate date={note.data.pubDate} />
							<div>
								<h2 class="writing-title">
									<a href={`/blog/${note.id}/`}>{note.data.title}</a>
								</h2>
								<p class="writing-description">{note.data.description}</p>
							</div>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
