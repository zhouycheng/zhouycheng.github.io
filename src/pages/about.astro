---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_AUTHOR, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`关于 | ${SITE_TITLE}`} description={`关于 ${SITE_AUTHOR} 和这个日志站。`} />
	</head>
	<body>
		<Header />
		<main>
			<article class="prose">
				<p class="eyebrow">About</p>
				<h1>关于这个地方</h1>
				<p>
					这里是一个独立的日志博客，和个人网站、作品集分开维护。个人网站更像展示页，这里更像工作台边上的记录本。
				</p>
				<p>
					我会在这里写项目复盘、学习过程、技术手记，也会写一些暂时没有结论的观察。文章不追求立刻完整，但希望每一篇都能留下一点真实的判断。
				</p>
				<p>
					后续个人网站部署好以后，会从个人网站跳转到这里；这个站点则保持简单，尽量只服务于写作和归档。
				</p>
			</article>
		</main>
		<Footer />
	</body>
</html>
