---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import SiteShell from '../components/SiteShell.astro';
import { SITE_AUTHOR, SITE_TITLE } from '../consts';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
const backHref = '/';
const backLabel = '返回文章';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = heroImage ? new URL(heroImage.src, Astro.site).toString() : undefined;
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	mainEntityOfPage: canonicalURL.toString(),
	author: {
		'@type': 'Person',
		name: SITE_AUTHOR,
	},
	publisher: {
		'@type': 'Organization',
		name: SITE_TITLE,
	},
	image: imageURL ? [imageURL] : undefined,
};
const structuredDataJSON = JSON.stringify(structuredData).replace(/</g, '\\u003c');
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} image={heroImage} type="article" />
		<script type="application/ld+json" set:html={structuredDataJSON} />
		<style>
			.hero-image {
				margin: 0 0 2.5rem;
			}
			.hero-image img {
				display: block;
				width: 100%;
				border-radius: 8px;
				box-shadow: var(--shadow);
			}
			.prose {
				max-width: 720px;
			}
			.post-header {
				margin-bottom: 2.5rem;
			}
			.post-header h1 {
				display: inline;
				margin: 0;
				font-family:
					"Atkinson Local", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
				font-size: clamp(2rem, 5vw, 3.6rem);
				line-height: 1.18;
				text-decoration-line: underline;
				text-decoration-thickness: 2px;
				text-decoration-color: var(--ink);
				text-underline-offset: 0.12em;
			}
			.post-date {
				margin: 1rem 0 0;
				color: var(--faint);
				font-size: 0.92rem;
			}
			.back-link {
				display: inline-block;
				margin-top: 3rem;
				color: var(--muted);
				text-decoration: none;
			}
			.back-link:hover {
				color: var(--accent);
			}

		@media (max-width: 720px) {
			.post-shell .site-rail {
				display: none;
			}
		}
	</style>
	</head>

	<body>
		<SiteShell class="post-shell">
			<article class="post-article">
				{
					heroImage && (
						<div class="hero-image">
							<Image width={1020} height={510} src={heroImage} alt="" />
						</div>
					)
				}
				<div class="prose">
					<header class="post-header">
						<h1>{title}</h1>
						<p class="post-date">Date · <FormattedDate date={pubDate} /></p>
					</header>
					<slot />
					<a class="back-link" href={backHref}>{backLabel}</a>
				</div>
			</article>
		</SiteShell>
	</body>
</html>
